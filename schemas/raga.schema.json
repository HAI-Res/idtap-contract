{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idtap.swara.studio/schemas/raga.schema.json",
  "title": "Raga",
  "description": "Serialized form of a Raga, the source of truth for the (stratifiedRatios, fundamental) context threaded into every Pitch. PROP-1: `ruleSet` IS now serialized so a piece's raga is self-contained (interpretable without a DB lookup) and non-Yaman ragas round-trip. `ruleSet` is migrated-optional: emitted for all new data, tolerated-absent on legacy pieces (both implementations then default it to Yaman and heal-forward on next save). See PROPOSALS.md PROP-1.",
  "type": "object",
  "required": ["name", "fundamental", "ratios", "tuning"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "fundamental": {
      "description": "Center-sa frequency in Hz.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "ratios": {
      "description": "Flat ratio array, one entry per pitch present in the rule set, in rule-set key order. Max 12.",
      "type": "array",
      "items": { "type": "number", "exclusiveMinimum": 0 },
      "maxItems": 12
    },
    "tuning": { "$ref": "#/$defs/tuning" },
    "ruleSet": {
      "description": "Which scale degrees are present. sa/pa are always-present booleans; re/ga/ma/dha/ni carry {lowered,raised} presence flags. Migrated-optional (see title). Determines ratios array length and stratifiedRatios shape.",
      "$ref": "#/$defs/ruleSet"
    }
  },
  "$defs": {
    "presencePair": {
      "type": "object",
      "required": ["lowered", "raised"],
      "additionalProperties": false,
      "properties": {
        "lowered": { "type": "boolean" },
        "raised": { "type": "boolean" }
      }
    },
    "ruleSet": {
      "type": "object",
      "required": ["sa", "re", "ga", "ma", "pa", "dha", "ni"],
      "additionalProperties": false,
      "properties": {
        "sa": { "type": "boolean" },
        "re": { "$ref": "#/$defs/presencePair" },
        "ga": { "$ref": "#/$defs/presencePair" },
        "ma": { "$ref": "#/$defs/presencePair" },
        "pa": { "type": "boolean" },
        "dha": { "$ref": "#/$defs/presencePair" },
        "ni": { "$ref": "#/$defs/presencePair" }
      }
    },
    "numOrPair": {
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        {
          "type": "object",
          "required": ["lowered", "raised"],
          "additionalProperties": false,
          "properties": {
            "lowered": { "type": "number", "exclusiveMinimum": 0 },
            "raised": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "tuning": {
      "type": "object",
      "required": ["sa", "re", "ga", "ma", "pa", "dha", "ni"],
      "additionalProperties": false,
      "properties": {
        "sa": { "type": "number", "exclusiveMinimum": 0 },
        "re": { "$ref": "#/$defs/numOrPair" },
        "ga": { "$ref": "#/$defs/numOrPair" },
        "ma": { "$ref": "#/$defs/numOrPair" },
        "pa": { "type": "number", "exclusiveMinimum": 0 },
        "dha": { "$ref": "#/$defs/numOrPair" },
        "ni": { "$ref": "#/$defs/numOrPair" }
      }
    }
  }
}
